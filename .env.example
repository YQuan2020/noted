# MySQL
MYSQL_ROOT_PASSWORD=noted_root
MYSQL_DATABASE=noted
MYSQL_USER=noted
MYSQL_PASSWORD=noted_password

# Backend
DATABASE_URL=mysql://noted:noted_password@db:3306/noted
PORT=3000
# Storage driver: "local" or "oss"
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads

# Optional OSS (Alibaba Cloud / S3-compatible) — leave blank unless STORAGE_DRIVER=oss
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=
