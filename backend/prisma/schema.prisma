generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  cards     Card[]
  images    Image[]
  relations CardRelation[]
  decks     Deck[]
  media     Media[]
  reviews   ReviewLog[]
  createdAt DateTime @default(now())
}

model Image {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  url          String?
  createdAt    DateTime @default(now())

  cards Card[]
  media Media[]

  @@index([userId])
}

model Card {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  front        String    @db.Text
  back         String    @db.Text
  mermaid      String?   @db.Text
  wordPart     String?
  rootOrigin   String?
  imageId      String?
  image        Image?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  deckId       String?
  deck         Deck?     @relation(fields: [deckId], references: [id], onDelete: SetNull)

  // Spaced-repetition scheduling (Anki-style, simplified)
  due          DateTime?
  intervalDays Float     @default(0)
  ease         Float     @default(2.5)
  reps         Int       @default(0)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  relationsAsSource CardRelation[] @relation("SourceCard")
  relationsAsTarget CardRelation[] @relation("TargetCard")
  relationCards     CardRelation[] @relation("RelationCard")
  reviews           ReviewLog[]

  @@index([userId])
  @@index([userId, due])
}

model CardRelation {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceCardId   String
  sourceCard     Card     @relation("SourceCard", fields: [sourceCardId], references: [id], onDelete: Cascade)
  targetCardId   String
  targetCard     Card     @relation("TargetCard", fields: [targetCardId], references: [id], onDelete: Cascade)
  relationCardId String?
  relationCard   Card?    @relation("RelationCard", fields: [relationCardId], references: [id], onDelete: SetNull)
  label          String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([sourceCardId])
  @@index([targetCardId])
}

model ReviewLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  grade     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([cardId])
}

model Deck {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  cards     Card[]
  media     Media[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Media {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String   @db.Text
  url       String?  @db.Text
  notes     String?  @db.Text
  content   String?  @db.Text
  fileId    String?
  file      Image?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  deckId    String?
  deck      Deck?    @relation(fields: [deckId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
}
